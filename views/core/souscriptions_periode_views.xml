<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_souscription_periode_list" model="ir.ui.view">
        <field name="name">souscription.periode.list</field>
        <field name="model">souscription.periode</field>
        <field name="arch" type="xml">
            <list decoration-info="facture_legacy_ref and not facture_id">
                <field name="souscription_id"/>
                <field name="pdl" optional="hide"/>
                <field name="mois_annee"/>
                <field name="date_debut" optional="hide"/>
                <field name="date_fin" optional="hide"/>
                <field name="config_cadrans" optional="hide"/>
                <field name="lisse" optional="hide"/>
                <field name="jours" optional="hide"/>
                <!-- Énergies : champs stockés (energie_base_kwh dérive déjà le
                     total HP+HC en config hp_hc/4_cadrans, ADR 0005), donc
                     triables au clic de colonne nativement (aucun calcul
                     ajouté ici) — HP/HC sortis en optionnel pour repérer un
                     cadran défaillant isolément sur un contrat HP/HC (« trier
                     par valeur, repérer l'aberrant »). -->
                <field name="energie_base_kwh" string="Énergie (kWh)"/>
                <field name="energie_hp_kwh" string="Énergie HP (kWh)" optional="show"/>
                <field name="energie_hc_kwh" string="Énergie HC (kWh)" optional="show"/>
                <!-- Verdicts electricore (ADR 0020 §4/§7, méta-périodes v3) :
                     lecture seule, servis tels quels par le pull — aucun
                     calcul local. -->
                <field name="qualite" widget="badge"
                       decoration-success="qualite == 'réelle'"
                       decoration-warning="qualite == 'estimée'"
                       decoration-danger="qualite == 'incalculable'"/>
                <field name="statut_communication" widget="badge"
                       decoration-success="statut_communication == 'communicante'"
                       decoration-warning="statut_communication == 'non_communicante'"
                       optional="show"/>
                <field name="has_changement" optional="show"/>
                <field name="turpe_fixe" optional="hide"/>
                <field name="turpe_variable" optional="hide"/>
                <field name="facture_id"/>
                <field name="facture_state" widget="badge"
                       decoration-success="facture_state == 'posted'"
                       decoration-warning="facture_state == 'draft'"/>
                <!-- Période d'ouverture (#107) : facturée côté legacy, pas
                     d'account.move — la référence prod est le marqueur
                     d'identification, mise en évidence par la couleur de ligne. -->
                <field name="facture_legacy_ref" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_souscription_periode_form" model="ir.ui.view">
        <field name="name">souscription.periode.form</field>
        <field name="model">souscription.periode</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Période">
                            <field name="souscription_id"/>
                            <field name="pdl"/>
                            <field name="date_debut"/>
                            <field name="date_fin"/>
                            <field name="mois_annee"/>
                            <field name="mois"/>
                            <field name="jours"/>
                            <field name="type_periode"/>
                            <field name="ref_situation_contractuelle"/>
                        </group>
                        <group string="Contrat (historisé)">
                            <field name="config_cadrans"/>
                            <!-- Gating des colonnes du justificatif de relevés
                                 (#138) : booléens calculés, jamais affichés
                                 tels quels, juste chargés pour parent.X plus
                                 bas dans le sous-formulaire releve_ids. -->
                            <field name="releve_show_base" invisible="1"/>
                            <field name="releve_show_hphc" invisible="1"/>
                            <field name="releve_show_4cadrans" invisible="1"/>
                            <field name="type_tarif_periode"/>
                            <field name="puissance_souscrite_periode"/>
                            <field name="lisse_periode"/>
                            <field name="tarif_solidaire_periode"/>
                            <field name="regime_prix_periode"/>
                            <field name="provision_mensuelle_kwh_periode"/>
                            <field name="coeff_pro_periode"/>
                        </group>
                    </group>

                    <!-- Atterrissage du contrat PeriodeMeta v3 electricore (#76,
                         ADR 0020 §4/§7) : verdicts jumeaux, montants et grandeur
                         physique servis par le pull, visibles du·de la facturiste. -->
                    <group string="Atterrissage electricore (v3)">
                        <field name="qualite"/>
                        <field name="statut_communication"/>
                        <field name="has_changement"/>
                        <field name="puissance_moyenne_kva"/>
                        <field name="cta_eur"/>
                        <field name="taux_accise_eur_mwh"/>
                        <field name="source_hash"/>
                    </group>

                    <!-- Énergie : niveau de saisie piloté par le calendrier de comptage
                         (config_cadrans) ; provisions/écart pilotés par le type de tarif
                         facturé et le lissage (ADR 0005). -->
                    <group string="Énergie">
                        <group string="Mesure réseau (cadrans)"
                               invisible="config_cadrans != '4_cadrans'">
                            <field name="energie_hph_kwh"/>
                            <field name="energie_hpb_kwh"/>
                            <field name="energie_hch_kwh"/>
                            <field name="energie_hcb_kwh"/>
                        </group>
                        <group string="Mesuré / estimé">
                            <field name="energie_hp_kwh"
                                   invisible="config_cadrans == 'base'"
                                   readonly="config_cadrans != 'hp_hc'"/>
                            <field name="energie_hc_kwh"
                                   invisible="config_cadrans == 'base'"
                                   readonly="config_cadrans != 'hp_hc'"/>
                            <field name="energie_base_kwh"
                                   string="Énergie BASE (kWh)"
                                   readonly="config_cadrans != 'base'"/>
                        </group>
                        <group string="Provision &amp; écart" invisible="not lisse_periode">
                            <field name="provision_hp_kwh" invisible="type_tarif_periode != 'hphc'"/>
                            <field name="ecart_hp_kwh" invisible="type_tarif_periode != 'hphc'"/>
                            <field name="provision_hc_kwh" invisible="type_tarif_periode != 'hphc'"/>
                            <field name="ecart_hc_kwh" invisible="type_tarif_periode != 'hphc'"/>
                            <field name="provision_base_kwh" invisible="type_tarif_periode != 'base'"/>
                            <field name="ecart_base_kwh" invisible="type_tarif_periode != 'base'"/>
                        </group>
                        <group string="TURPE">
                            <field name="turpe_fixe"/>
                            <field name="turpe_variable"/>
                        </group>
                    </group>

                    <!-- Relevés d'index utilisés (ADR 0015, amendé #138) : justificatif
                         légal du calcul d'énergie, saisi à la main par le·la facturiste.
                         Forme large par cadran réseau ; les colonnes affichées suivent
                         l'UNION des familles réellement relevées (releve_show_*,
                         calculés depuis _familles_relevees()) — pas config_cadrans
                         directement, qui ne sert plus que de repli (aucun index saisi). -->
                    <group string="Relevés d'index utilisés">
                        <field name="releve_ids" nolabel="1" colspan="2">
                            <list editable="bottom">
                                <field name="date"/>
                                <field name="nature"/>
                                <field name="index_base"
                                       column_invisible="not parent.releve_show_base"/>
                                <field name="index_hp"
                                       column_invisible="not parent.releve_show_hphc"/>
                                <field name="index_hc"
                                       column_invisible="not parent.releve_show_hphc"/>
                                <field name="index_hph"
                                       column_invisible="not parent.releve_show_4cadrans"/>
                                <field name="index_hpb"
                                       column_invisible="not parent.releve_show_4cadrans"/>
                                <field name="index_hch"
                                       column_invisible="not parent.releve_show_4cadrans"/>
                                <field name="index_hcb"
                                       column_invisible="not parent.releve_show_4cadrans"/>
                                <field name="releve_externe_id"/>
                                <field name="origine"/>
                            </list>
                        </field>
                    </group>

                    <group string="Documents">
                        <field name="facture_id"/>
                        <field name="facture_state"/>
                        <!-- Période d'ouverture (#107, ADR 0023) : backfill lié
                             à une facture PROD (Odoo 17), hors du système —
                             pas d'account.move ; ce champ est le marqueur
                             d'identification de la Période d'ouverture. -->
                        <field name="facture_legacy_ref"/>
                        <!-- État « régularisée » posé par la migration (PRD
                             #207/#208, ADR 0030 décision 4) : mois déjà soldé
                             côté prod, exclu des candidats de la
                             Régularisation (#236). -->
                        <field name="legacy_regularisee"/>
                    </group>
                    <!-- Tous les documents liés (factures, avoirs…), brouillons
                         compris : une facture remise en brouillon reste visible ici. -->
                    <field name="move_ids" readonly="1">
                        <list>
                            <field name="name"/>
                            <field name="invoice_date"/>
                            <field name="move_type"/>
                            <field name="state" widget="badge"
                                   decoration-success="state == 'posted'"
                                   decoration-warning="state == 'draft'"/>
                            <field name="amount_total"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search view (#337, ADR 0020 §4/§7, PRD #335) : filtres sur chaque
         verdict electricore et sur le lissage, groupages qualité / statut de
         communication / souscription / mois — le geste « scanner la masse,
         vérifier les lignes douteuses ». Aucun moteur de filtres custom : les
         combinaisons se composent et s'enregistrent via les filtres favoris
         natifs d'Odoo. -->
    <record id="view_souscription_periode_search" model="ir.ui.view">
        <field name="name">souscription.periode.search</field>
        <field name="model">souscription.periode</field>
        <field name="arch" type="xml">
            <search>
                <field name="souscription_id"/>
                <field name="pdl"/>
                <field name="mois_annee"/>
                <filter string="Qualité réelle" name="qualite_reelle" domain="[('qualite', '=', 'réelle')]"/>
                <filter string="Qualité estimée" name="qualite_estimee" domain="[('qualite', '=', 'estimée')]"/>
                <filter string="Incalculable" name="qualite_incalculable" domain="[('qualite', '=', 'incalculable')]"/>
                <separator/>
                <filter string="Communicante" name="communicante" domain="[('statut_communication', '=', 'communicante')]"/>
                <filter string="Non communicante" name="non_communicante" domain="[('statut_communication', '=', 'non_communicante')]"/>
                <separator/>
                <filter string="Changement pendant la période" name="has_changement" domain="[('has_changement', '=', True)]"/>
                <separator/>
                <filter string="Lissé" name="lisse_periode" domain="[('lisse_periode', '=', True)]"/>
                <filter string="Non lissé" name="non_lisse_periode" domain="[('lisse_periode', '=', False)]"/>
                <group expand="0" string="Grouper par">
                    <filter string="Qualité" name="group_qualite" context="{'group_by': 'qualite'}"/>
                    <filter string="Statut de communication" name="group_statut_communication" context="{'group_by': 'statut_communication'}"/>
                    <filter string="Souscription" name="group_souscription" context="{'group_by': 'souscription_id'}"/>
                    <filter string="Mois" name="group_mois" context="{'group_by': 'mois'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_souscription_periode" model="ir.actions.act_window">
        <field name="name">Périodes de facturation</field>
        <field name="res_model">souscription.periode</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_souscription_periode_list"/>
        <field name="search_view_id" ref="view_souscription_periode_search"/>
    </record>

    <menuitem
        id="menu_souscription_periode"
        name="Périodes de facturation"
        parent="menu_souscription_root"
        action="action_souscription_periode"
        sequence="20"/>
</odoo>
