<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Matrice à prérequis (ADR 0025) : chaque ligne est une étape du DAG,
         seedée à la création (#156). Pas d'ajout/suppression manuel : le
         catalogue d'étapes est fixe (create="0" delete="0"). -->
    <record id="view_souscription_campagne_facturation_form" model="ir.ui.view">
        <field name="name">souscription.campagne.facturation.form</field>
        <field name="model">souscription.campagne.facturation</field>
        <field name="arch" type="xml">
            <form string="Campagne de facturation">
                <sheet>
                    <!-- Bandeau de stats natif (#301) : stat buttons standard Odoo, pas de
                         CSS custom. Entonnoir (à tirer/à facturer/facturées/émises) en
                         buckets EXACTS (#301, _souscriptions_par_bucket) — à ne pas
                         confondre avec le reste-à-faire CUMULATIF de la matrice des étapes
                         ci-dessous (#157). Remplace le groupe « Factures du mois ». -->
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_drill_down_perimetre" icon="fa-users">
                            <field name="nb_perimetre" widget="statinfo" string="Périmètre"/>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_drill_down_a_tirer" icon="fa-cloud-download">
                            <field name="nb_a_tirer" widget="statinfo" string="À tirer"/>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_drill_down_a_facturer" icon="fa-file-text-o">
                            <field name="nb_a_facturer" widget="statinfo" string="À facturer"/>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_drill_down_facturees" icon="fa-pencil-square-o">
                            <field name="nb_facturees_brouillon" widget="statinfo" string="Facturées"/>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_drill_down_emises" icon="fa-check-circle">
                            <field name="nb_emises_bucket" widget="statinfo" string="Émises"/>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_drill_down_total_emis" icon="fa-eur">
                            <div class="o_stat_info">
                                <span class="o_stat_value">
                                    <field name="total_emis_ttc" widget="monetary"/>
                                </span>
                                <span class="o_stat_text">Total émis TTC</span>
                            </div>
                        </button>
                    </div>
                    <field name="currency_id" invisible="1"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <field name="mois"/>
                    </group>
                    <notebook>
                        <page string="Étapes" name="etapes">
                            <field name="etape_ids" create="0" delete="0">
                                <!-- Prochaine étape en évidence (#301), décorations XML pures :
                                     faites grisées, prêtes-non-faites en gras. Le DAG peut avoir
                                     plusieurs racines actionnables à la fois (#156) : le gras les
                                     montre toutes, sans notion de « la » prochaine étape unique. -->
                                <list editable="bottom" create="0" delete="0"
                                      decoration-muted="fait" decoration-bold="etat_prerequis == 'prete' and not fait">
                                    <field name="sequence" widget="handle"/>
                                    <field name="code" readonly="1"/>
                                    <field name="type_etape" column_invisible="1"/>
                                    <field name="etat_prerequis" widget="badge"
                                           decoration-success="etat_prerequis == 'prete'"
                                           decoration-warning="etat_prerequis == 'bloquee'"/>
                                    <field name="valide" widget="boolean_toggle" invisible="type_etape != 'porte'"/>
                                    <field name="valide_par_id" readonly="1" invisible="not valide"/>
                                    <field name="valide_le" readonly="1" invisible="not valide"/>
                                    <field name="nb_reste_a_faire"
                                           invisible="type_etape != 'derive' and code != 'preparer_prelevements'"/>
                                    <field name="fait" widget="boolean" readonly="1"/>
                                    <!-- Étapes dérivées/action (#158) : un seul bouton générique qui
                                         dispatche vers l'action de la Campagne (pull/sync/créer/émettre).
                                         Seules les portes se valident via la case `valide` ci-dessus ;
                                         sync F15 (action) est « faite » dès son lancement (`lance`). -->
                                    <button name="action_executer" type="object" string="Lancer"
                                            class="btn-link" invisible="type_etape == 'porte'"/>
                                    <button name="action_drill_down" type="object" string="Voir" icon="fa-search"/>
                                </list>
                            </field>
                        </page>
                        <!-- Notes dédiées (#159) : pas le chatter (qui ne sait ni flaguer
                             « à reporter » ni se chaîner d'un mois à l'autre). Les prérequis
                             repris (surlignés) sont des rappels doux, jamais des portes du DAG. -->
                        <page string="Notes" name="notes">
                            <field name="note_ids">
                                <list editable="bottom" decoration-info="reprise">
                                    <field name="texte"/>
                                    <field name="a_reporter"/>
                                    <field name="traite"/>
                                    <field name="reprise" readonly="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Liste triée mois décroissant = l'historique (#156). Colonnes
         enrichies (#301) : l'historique se lit sans ouvrir chaque mois —
         toutes dérivées, aucun nouveau champ stocké (esprit ADR 0025). -->
    <record id="view_souscription_campagne_facturation_list" model="ir.ui.view">
        <field name="name">souscription.campagne.facturation.list</field>
        <field name="model">souscription.campagne.facturation</field>
        <field name="arch" type="xml">
            <list string="Campagnes de facturation">
                <field name="name"/>
                <field name="mois"/>
                <field name="etapes_faites" string="Étapes faites"/>
                <field name="nb_factures_emises" string="Factures émises"/>
                <field name="total_emis_ttc" string="Total TTC"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="action_souscription_campagne_facturation" model="ir.actions.act_window">
        <field name="name">Campagnes</field>
        <field name="res_model">souscription.campagne.facturation</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- « Cycle de facturation » = la récurrence / le nom du menu ; chaque
         enregistrement listé est une Campagne (CONTEXT.md « Campagne de
         facturation »). Créée par un bouton manuel (le "Nouveau" standard de
         la liste) — pas de cron. -->
    <menuitem
        id="menu_souscription_campagne_facturation"
        name="Cycle de facturation"
        parent="menu_souscription_root"
        action="action_souscription_campagne_facturation"
        sequence="20"/>
</odoo>
