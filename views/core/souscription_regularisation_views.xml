<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Régularisation (solde), toujours en brouillon dans cette tranche
         (#236, ADR 0030 décisions 3-4) : formulaire de review du·de la
         facturiste — lignes typées grille × cadran, signalements du dernier
         recalcul. -->
    <record id="view_souscription_regularisation_form" model="ir.ui.view">
        <field name="name">souscription.regularisation.form</field>
        <field name="model">souscription.regularisation</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_recalculer" type="object" string="Recalculer"
                            class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="souscription_id"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Couverture">
                            <field name="date_debut"/>
                            <field name="date_fin"/>
                            <field name="montant_total"/>
                        </group>
                    </group>
                    <field name="signalements" invisible="not signalements"/>
                    <notebook>
                        <page string="Lignes" name="lignes">
                            <field name="ligne_ids">
                                <list editable="bottom" create="0">
                                    <field name="grille_id"/>
                                    <field name="cadran"/>
                                    <field name="date_debut"/>
                                    <field name="date_fin"/>
                                    <field name="ecart_kwh"/>
                                    <field name="prix_kwh"/>
                                    <field name="montant" sum="Total"/>
                                </list>
                                <form>
                                    <group>
                                        <field name="grille_id"/>
                                        <field name="cadran"/>
                                        <field name="date_debut"/>
                                        <field name="date_fin"/>
                                        <field name="ecart_kwh"/>
                                        <field name="prix_kwh"/>
                                        <field name="montant"/>
                                        <field name="detail"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page string="Relevés (justificatif)" name="releves">
                            <field name="releve_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_souscription_regularisation_list" model="ir.ui.view">
        <field name="name">souscription.regularisation.list</field>
        <field name="model">souscription.regularisation</field>
        <field name="arch" type="xml">
            <list>
                <field name="souscription_id"/>
                <field name="date_debut"/>
                <field name="date_fin"/>
                <field name="montant_total" sum="Total"/>
            </list>
        </field>
    </record>

    <record id="action_souscription_regularisation" model="ir.actions.act_window">
        <field name="name">Régularisations</field>
        <field name="res_model">souscription.regularisation</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_souscription_regularisation"
        name="Régularisations"
        parent="menu_souscription_root"
        action="action_souscription_regularisation"
        sequence="32"/>
</odoo>
