<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Matrice à prérequis (ADR 0025) : chaque ligne est une étape du DAG,
         seedée à la création (#156). Pas d'ajout/suppression manuel : le
         catalogue d'étapes est fixe (create="0" delete="0"). -->
    <record id="view_souscription_campagne_facturation_form" model="ir.ui.view">
        <field name="name">souscription.campagne.facturation.form</field>
        <field name="model">souscription.campagne.facturation</field>
        <field name="arch" type="xml">
            <form string="Campagne de facturation">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <field name="mois"/>
                    </group>
                    <notebook>
                        <page string="Étapes" name="etapes">
                            <field name="etape_ids" create="0" delete="0">
                                <list editable="bottom" create="0" delete="0">
                                    <field name="sequence" widget="handle"/>
                                    <field name="code" readonly="1"/>
                                    <field name="type_etape" column_invisible="1"/>
                                    <field name="etat_prerequis" widget="badge"
                                           decoration-success="etat_prerequis == 'prete'"
                                           decoration-warning="etat_prerequis == 'bloquee'"/>
                                    <field name="valide" widget="boolean_toggle" invisible="type_etape != 'porte'"/>
                                    <field name="valide_par_id" readonly="1" invisible="not valide"/>
                                    <field name="valide_le" readonly="1" invisible="not valide"/>
                                    <field name="fait" widget="boolean" readonly="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Liste triée mois décroissant = l'historique (#156). -->
    <record id="view_souscription_campagne_facturation_list" model="ir.ui.view">
        <field name="name">souscription.campagne.facturation.list</field>
        <field name="model">souscription.campagne.facturation</field>
        <field name="arch" type="xml">
            <list string="Campagnes de facturation">
                <field name="name"/>
                <field name="mois"/>
            </list>
        </field>
    </record>

    <record id="action_souscription_campagne_facturation" model="ir.actions.act_window">
        <field name="name">Campagnes</field>
        <field name="res_model">souscription.campagne.facturation</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- « Cycle de facturation » = la récurrence / le nom du menu ; chaque
         enregistrement listé est une Campagne (CONTEXT.md « Campagne de
         facturation »). Créée par un bouton manuel (le "Nouveau" standard de
         la liste) — pas de cron. -->
    <menuitem
        id="menu_souscription_campagne_facturation"
        name="Cycle de facturation"
        parent="menu_souscription_root"
        action="action_souscription_campagne_facturation"
        sequence="20"/>
</odoo>
